// Create Employee View
const CreateEmployee = () => {
  const { token } = useAuth();
  const [employees, setEmployees] = useState([]);
  const [formData, setFormData] = useState({
    emp_id: '',
    name: '',
    email: '',
    designation: '',
    mgr_id: '',
    password: '',
    role: 'developer'
  });
  const [success, setSuccess] = useState('');
  const [error, setError] = useState('');

  useEffect(() => {
    fetchEmployees();
  }, []);

  const fetchEmployees = async () => {
    try {
      const data = await apiCall('/api/v1/employees', 'GET', null, token);
      setEmployees(data);
    } catch (err) {
      console.error(err);
    }
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setError('');
    setSuccess('');

    try {
      const { password, role, ...employeeData } = formData;
      await apiCall('/api/v1/employees', 'POST', employeeData, token);
      
      await apiCall('/api/v1/users', 'POST', {
        emp_id: parseInt(formData.emp_id),
        password: password,
        role: role
      }, token);

      setSuccess('Employee and user created successfully!');
      setFormData({
        emp_id: '',
        name: '',
        email: '',
        designation: '',
        mgr_id: '',
        password: '',
        role: 'developer'
      });
      fetchEmployees();
    } catch (err) {
      setError(err.message);
    }
  };

  return (
    <div className="p-6 max-w-2xl">
      <h2 className="text-2xl font-bold mb-6">Create Employee</h2>

      <form onSubmit={handleSubmit} className="bg-white rounded-lg shadow p-6 space-y-4">
